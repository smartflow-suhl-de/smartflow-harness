{
  "model": "gpt-4.1-mini",
  "baseUrl": "https://api.openai.com/v1",
  "contextWindow": 128000,
  "mode": "default",
  "maxSteps": 60,
  "rules": [
    { "tool": "bash", "pattern": "^(ls|cat|git status|git diff|git log)", "action": "allow" },
    { "tool": "bash", "pattern": "^git push", "action": "ask" }
  ]
}
